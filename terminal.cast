[0.002, "o", "\r\n\u001b[1;36m$ studioctl env up --help      # shared options, then one section per runtime\u001b[0m\r\n"]
[2.054, "o", "Usage: studioctl env up [options]\r\n\r\nStart a local environment.\r\n\r\nOptions:\r\n  -r, --runtime    Runtime: localtest (default: the one running, else localtest)\r\n  -d, --detach     Run in background (default: true)\r\n  --open           Open the environment in the browser after starting\r\n  --json           Output as JSON\r\n\r\nOptions for the localtest runtime:\r\n  --monitoring     Start monitoring stack\r\n  --pgadmin        Start pgAdmin for the workflow-engine database\r\n"]
