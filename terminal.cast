[0.002, "o", "\r\n\u001b[1;36m$ studioctl env up --help | tail -n +8        # one options section per runtime\u001b[0m\r\n"]
[2.055, "o", "  --open           Open the environment in the browser after starting\r\n  --json           Output as JSON\r\n\r\nOptions for the localtest runtime:\r\n  --monitoring     Start monitoring stack\r\n  --pgadmin        Start pgAdmin for the workflow-engine database\r\n\r\nOptions for the localtest-v2 runtime:\r\n  --latest         Run the research images at :latest instead of the pinned build\r\n  --minimal        Run in minimal mode: Postgres, Storage, the workflow engine and the localtest container,\r\n                   which emulates the other services; nothing is kept between starts\r\n  --host HOST      The public host (default local.altinn.cloud); HOST and its subdomains pdf.,\r\n                   workflow-engine., app-frontend. and af. must resolve to 127.0.0.1 (the hosts file)\r\n  --port PORT      The public port (default 8000); 0 picks a free port\r\n                   A running environment keeps its host and port; other values restart it\r\n  --dev-NAME[=PATH]\r\n                   Build the container NAME from PATH, a Dockerfile or a directory holding one\r\n                   (default: the current directory), and run it instead of the pinned image; NAME is one of\r\n                   postgres, register, profile, authentication, authorization, storage, access-management, events, resource-registry, notifications, localtest, pdf3, workflow-engine, redis, dialogporten-webapi, dialogporten-graphql, dialogporten-service, dialogporten-adapter, receipt, correspondence, arbeidsflate-bff, arbeidsflate, victoria-metrics, victoria-traces, victoria-logs, otel-files, otel-collector, grafana\r\n  --with GROUP     Start an optional group: its containers and what they depend on (dialogporten, receipt, correspondence, arbeidsflate, monitoring, everything; repeatable)\r\n  --without GROUP  Leave out an optional group's own containers (repeatable)\r\n"]
[4.004, "o", "\r\n\u001b[1;36m$ echo $STUDIO_CA_BUNDLE\u001b[0m\r\n"]
[2.008, "o", "/etc/ssl/certs/ca-certificates.crt\r\n\r\n\u001b[1;36m$ studioctl env up -r localtest-v2\u001b[0m\r\n"]
