<Project Sdk="Microsoft.NET.Sdk">

  <!--
    xunit v3 home for the WebApplicationFactory-based API tests, which Altinn.App.Api.Tests (xunit v2) hands over in
    batches. Until the move is complete the test infrastructure (test host, mocks, test data) is linked from the v2
    project so that there is one copy of it.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are executables; Program.cs provides the entry point. -->
    <OutputType>Exe</OutputType>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <RootNamespace>Altinn.App.Api.Tests</RootNamespace>

    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <!--
      CS0618: This is a test project, so we usually continue testing [Obsolete] apis
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions"/>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing"/>
    <PackageReference Include="Microsoft.AspNetCore.TestHost"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="Moq"/>
    <PackageReference Include="Verify.XunitV3"/>
    <PackageReference Include="xunit.v3"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Altinn.App.Tests.Common"/>
    <Using Include="Altinn.App.Tests.Common.Auth"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Altinn.App.Api/Altinn.App.Api.csproj"/>
    <ProjectReference Include="../Altinn.App.Tests.Common.XunitV3/Altinn.App.Tests.Common.XunitV3.csproj"/>
  </ItemGroup>

  <!--
    Test infrastructure shared with the v2 project while the tests move. Files that are tests themselves, the v2
    test host (Program.cs), the v2 base class (CustomWebApplicationFactory.cs) and the file-backed storage mocks
    (InstanceClientMockSi, DataClientMock, ApiTestStorageMetadata) are not linked: storage is the in-memory
    StorageClientInterceptor from Tests.Common behind the app's real clients.
    TestData.cs resolves the test data root from its own source path, so the app folders and the prepared
    instances that serve as templates are read from Altinn.App.Api.Tests/Data. This project only reads that
    folder.
  -->
  <ItemGroup>
    <Compile Include="../Altinn.App.Api.Tests/Data/**/*.cs" LinkBase="Data" />
    <Compile Include="../Altinn.App.Api.Tests/Mocks/**/*.cs" Exclude="../Altinn.App.Api.Tests/Mocks/**/*Tests.cs;../Altinn.App.Api.Tests/Mocks/InstanceClientMockSi.cs;../Altinn.App.Api.Tests/Mocks/DataClientMock.cs;../Altinn.App.Api.Tests/Mocks/ApiTestStorageMetadata.cs" LinkBase="Mocks" />
    <Compile Include="../Altinn.App.Api.Tests/Models/XacmlResourceAttributes.cs" Link="Models/XacmlResourceAttributes.cs" />
    <Compile Include="../Altinn.App.Api.Tests/Utils/**/*.cs" LinkBase="Utils" />
    <Compile Include="../Altinn.App.Api.Tests/TestStubs/**/*.cs" LinkBase="TestStubs" />
    <Compile Include="../Altinn.App.Api.Tests/Extensions/HttpClientExtensions.cs" Link="Extensions/HttpClientExtensions.cs" />
    <Compile Include="../Altinn.App.Api.Tests/FakeWorkflowEngineClient.cs" Link="FakeWorkflowEngineClient.cs" />
    <Compile Include="../Altinn.App.Api.Tests/WorkflowCallbackHttpContextAccessor.cs" Link="WorkflowCallbackHttpContextAccessor.cs" />
    <Compile Include="../Altinn.App.Api.Tests/MockHttpMessageHandler.cs" Link="MockHttpMessageHandler.cs" />
  </ItemGroup>
</Project>
